# Local environment values; examples must contain placeholders only.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Agent settings, session keys and logs; keep versioned skills visible.
.claude/settings.local.json
.claude/settings.local.*.json
.superpowers/brainstorm/
.codex-log/
.codex/log/
.codex/logs/
.codex/sessions/
